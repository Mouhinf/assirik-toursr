# Appwrite Configuration
# Get these values from your Appwrite Console (https://cloud.appwrite.io)

# Appwrite API endpoint (default: https://cloud.appwrite.io/v1)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Your Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=your_database_id_here

# Collection IDs - Create these 4 collections in your Appwrite database
VITE_APPWRITE_COLLECTION_VOYAGES=your_voyages_collection_id
VITE_APPWRITE_COLLECTION_IMMOBILIER=your_immobilier_collection_id
VITE_APPWRITE_COLLECTION_NETTOIEMENT=your_nettoiement_collection_id
VITE_APPWRITE_COLLECTION_CONTACTS=your_contacts_collection_id
