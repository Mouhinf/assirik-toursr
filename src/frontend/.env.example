# EmailJS Configuration
# Get these from https://dashboard.emailjs.com/

# Your public key (Account > General)
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Your email service ID (Email Services > your service)
VITE_EMAILJS_SERVICE_ID=your_service_id

# Template IDs for each department (Email Templates > template ID)
VITE_EMAILJS_TEMPLATE_VOYAGES=your_template_id_voyages
VITE_EMAILJS_TEMPLATE_IMMOBILIER=your_template_id_immobilier
VITE_EMAILJS_TEMPLATE_NETTOIEMENT=your_template_id_nettoiement
VITE_EMAILJS_TEMPLATE_CONTACT=your_template_id_contact
